pipeline {
    environment {
        REPO_URL = "https://github.com/benblasco/fedora-server-bootc"
        REPO_BRANCH = "${env.BRANCH_NAME}"
        IMAGE_NAME = "fedora-server-bootc"
        REGISTRY1 = "micro.lan:5000"
        REGISTRY2 = "nuc.lan:5000"
        DATESTAMP = sh(
                        script: """
                        date +%Y%m%d
                        """, returnStdout: true
                    )
    }
    agent { label 'fedora-server-bootc' }
    triggers {
        cron('H 6 * * 7') // Build between 6am and 7am every Sunday
    }
    stages {
        stage('Identify build node') {
            steps {
                echo 'Identify build node'
                sh 'hostnamectl'
            }
        }
        stage('Clone Repo') {
            steps {
                echo 'Clone build repo'
                git url: REPO_URL, branch: REPO_BRANCH
            }
        }
        stage('Build the image') {
            steps {
                echo 'Build the Fedora Bootc Container'
                sh '''
                    usage=$(df --output=pcent /var/lib/containers/storage | tail -1 | tr -d ' %')
                    if [ "$usage" -gt 90 ]; then
                        echo "Podman storage is ${usage}% full (threshold: 90%)"
                        df -h /var/lib/containers/storage
                        exit 1
                    fi
                '''
                sh 'sudo podman build --pull=always -t ${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH} -t ${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}-${DATESTAMP} .'
            }
        }
        stage('Push to the container registry') {
            steps {
                echo 'Push the build to the registries'
                echo 'Pushing image to registry ${REGISTRY1}'
                sh 'sudo podman push --tls-verify=false ${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}-${DATESTAMP}'
                sh 'sudo podman push --tls-verify=false ${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}'

                echo 'Copying image to registry ${REGISTRY2}'
                sh 'sudo skopeo copy --src-tls-verify=false --dest-tls-verify=false docker://${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}-${DATESTAMP} docker://${REGISTRY2}/${IMAGE_NAME}:${REPO_BRANCH}-${DATESTAMP}'
                sh 'sudo skopeo copy --src-tls-verify=false --dest-tls-verify=false docker://${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH} docker://${REGISTRY2}/${IMAGE_NAME}:${REPO_BRANCH}'
            }
        }
    }
    post {
        always {
            echo 'Clean up local images and podman storage'
            sh """
                sudo podman image rm '${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}-${DATESTAMP.trim()}' || true
                sudo podman image rm '${REGISTRY1}/${IMAGE_NAME}:${REPO_BRANCH}' || true
                sudo podman system prune -af --build
                df -h /var/lib/containers/storage
            """
        }
    }
}
